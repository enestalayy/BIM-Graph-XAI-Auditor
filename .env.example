# =============================================================================
# BIM-Graph-XAI-Auditor — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# -----------------------------------------------------------------------------
# Neo4j Database
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bim_auditor_2024
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# Google Gemini API (for LLM / XAI layer)
# -----------------------------------------------------------------------------
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# IFC Processing
IFC_BATCH_SIZE=500
IFC_USE_WORLD_COORDS=true

# Clash Detection
CLASH_TOLERANCE_M=0.01     # 1 cm tolerance for floating-point geometry
MIN_INTERSECTION_VOLUME=0.0001  # m³ — ignore trivial surface contacts

# XAI / RAG
RAG_MAX_CONTEXT_TOKENS=4096
RAG_TEMPERATURE=0.1        # Low temperature = deterministic, factual output
HALLUCINATION_THRESHOLD=0.95  # Grounding score below this triggers warning

# -----------------------------------------------------------------------------
# Paths (relative to project root)
# -----------------------------------------------------------------------------
DATA_DIR=data
PROCESSED_DIR=data/processed
REPORTS_DIR=data/reports
SAMPLE_IFC_PATH=data/sample/duplex_apartment.ifc
