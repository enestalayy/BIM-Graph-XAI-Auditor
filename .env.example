# Copy to .env and fill in. Never commit .env.

# --- Neo4j (docker compose reads NEO4J_USER / NEO4J_PASSWORD from here) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Integration tests and the fault-injection experiment only
# (docker compose --profile test up -d neo4j-test). They WIPE this database.
NEO4J_TEST_URI=bolt://localhost:7688

# --- Spatial reasoning ---
# AABB interpenetration tolerance in metres (default 0.001 = 1 mm)
CLASH_TOLERANCE_M=0.001

# --- Explanation layer ---
# template = deterministic, no LLM; ollama = local open-weight model (free)
EXPLAINER=template
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=180000

# --- API server ---
HOST=127.0.0.1
PORT=3000
RULES_FILE=rules/default.json
UPLOADS_DIR=data/uploads
MAX_UPLOAD_MB=500
