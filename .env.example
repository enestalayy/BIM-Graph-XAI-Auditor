# Copy to .env and fill in. Never commit .env.

# --- Neo4j (docker compose reads NEO4J_USER / NEO4J_PASSWORD from here) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Integration tests only (docker compose --profile test up -d neo4j-test). Tests WIPE this database.
NEO4J_TEST_URI=bolt://localhost:7688

# --- Explanation layer ---
# template = deterministic, no LLM; ollama = local open-weight model (free)
EXPLAINER=template
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- API server ---
PORT=3000
