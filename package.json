{
  "name": "bim-graph-xai-auditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Graph-based, explainable clash auditing for federated IFC models (master's thesis prototype)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/server/test/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 \"packages/*/test/integration/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
