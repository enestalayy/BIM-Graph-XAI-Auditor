{
  "name": "bim-graph-xai-auditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Graph-based, explainable clash auditing for federated IFC models (master's thesis prototype)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 \"packages/*/test/integration/*.test.ts\" \"apps/server/test/integration/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p apps/web/tsconfig.node.json",
    "parity": "node tools/parity/compare.ts data/sample/Building-Architecture.ifc data/sample/Building-Hvac.ifc",
    "cli": "node --env-file-if-exists=.env apps/server/src/cli.ts",
    "start": "node --env-file-if-exists=.env apps/server/src/main.ts",
    "dev:server": "node --env-file-if-exists=.env --watch apps/server/src/main.ts",
    "build": "npm run build -w @bim/web",
    "dev": "node tools/dev/run.ts",
    "datasets:fetch": "node tools/datasets/fetch.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
